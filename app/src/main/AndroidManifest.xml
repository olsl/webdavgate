<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 联网：上游转发到 Cloudflare 与 STUN 直连 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 前台服务保活：Android 9 起后台运行前台服务必须声明 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ dataSync 类型前台服务需要 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13+ 通知运行时权限（前台服务通知也受其约束） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 保活三件套：保持 CPU 不休眠（防止 ColorOS 等冻结进程导致网关无响应） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 引导用户加入电池优化白名单时弹系统确认框 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- STUN 直连地址为明文 http://ip:port，必须放开明文流量，否则 Android 9+ 会拒绝连接 -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WebDavGate"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LogViewerActivity"
            android:exported="false"
            android:label="@string/log_viewer_title"
            android:theme="@style/Theme.WebDavGate" />

        <!-- 网关前台服务：常驻通知 + dataSync 类型 -->
        <service
            android:name=".service.GatewayService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
